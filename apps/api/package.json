    "prisma": "prisma",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/client": "^6.16.3",
    "archiver": "^8.0.0",
    "argon2": "^0.44.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/pdfkit": "^0.17.6",
    "prisma": "^6.16.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
