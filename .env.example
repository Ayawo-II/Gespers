# --- Utilisé par docker compose (substitution de variables) ---
POSTGRES_USER=gespers
POSTGRES_PASSWORD=gespers
POSTGRES_DB=gespers
DATABASE_URL="postgresql://gespers:gespers@db:5432/gespers?schema=public"

# --- Hors Docker (runs host, ex: prisma depuis apps/api -> apps/api/.env) ---
# DATABASE_URL="postgresql://gespers:gespers@localhost:5432/gespers?schema=public"

# --- API (apps/api) ---
PORT=3001

# --- Web (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
